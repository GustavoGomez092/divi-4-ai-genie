{
    "attributes": {
        "content": {
            "attributes": {
                "class": "infowindow"
            },
            "elementType": "content",
            "selector": "{{selector}} .infowindow",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "attrName": "content.innerContent",
                        "category": "basic_option",
                        "component": {
                            "name": "divi/richtext",
                            "type": "field"
                        },
                        "description": "Here you can define the content that will be placed within the infobox for the pin.",
                        "features": {
                            "dynamicContent": {
                                "type": "text"
                            },
                            "preset": [
                                "style"
                            ],
                            "sticky": false
                        },
                        "groupSlug": "contentText",
                        "label": "Body",
                        "priority": 10,
                        "render": true
                    }
                }
            },
            "type": "object"
        },
        "pin": {
            "selector": "{{selector}}",
            "settings": {
                "advanced": {
                    "html": [],
                    "loop": []
                },
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "attrName": "pin.innerContent",
                        "category": "basic_option",
                        "component": {
                            "name": "divi/map",
                            "props": {
                                "hasMarker": false,
                                "hideUpdateButton": false,
                                "readonly": false
                            },
                            "type": "field"
                        },
                        "description": "Enter an address for this map pin, and the address will be geocoded and displayed on the map below.",
                        "features": {
                            "dynamicContent": {
                                "type": "text"
                            },
                            "hover": false,
                            "preset": "content",
                            "responsive": false,
                            "sticky": false
                        },
                        "groupSlug": "contentMap",
                        "label": "Map Pin Address",
                        "priority": 10,
                        "render": true
                    }
                },
                "meta": {
                    "meta": []
                }
            },
            "type": "object"
        },
        "title": {
            "childrenSanitizer": "et_core_esc_previously",
            "inlineEditor": "plainText",
            "selector": "{{selector}} h3",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "attrName": "title.innerContent",
                        "category": "basic_option",
                        "component": {
                            "name": "divi/text",
                            "type": "field"
                        },
                        "description": "The title will be used within the tab button for this tab.",
                        "features": {
                            "dynamicContent": {
                                "type": "text"
                            },
                            "preset": "content",
                            "sticky": false
                        },
                        "groupSlug": "contentText",
                        "label": "Title",
                        "priority": 10,
                        "render": true
                    }
                }
            },
            "tagName": "h3",
            "type": "object"
        }
    },
    "conversion": {
        "attributeMap": {
            "_builder_version": "builderVersion",
            "_module_preset": "modulePreset",
            "content": "content.innerContent.*",
            "inline_fonts": "content.decoration.inlineFont.*.families",
            "nonconvertible": "nonconvertible",
            "pin_address": "pin.innerContent.*.address",
            "pin_address_lat": "pin.innerContent.*.lat",
            "pin_address_lng": "pin.innerContent.*.lng",
            "shortcodeName": "shortcodeName",
            "title": "title.innerContent.*",
            "zoom_level": "pin.innerContent.*.zoom"
        },
        "conditionalAttributeConversionFunctionMap": [],
        "nonResponsiveAttributes": [],
        "optionEnableMap": [],
        "valueExpansionFunctionMap": {
            "inline_fonts": "convertInlineFont"
        }
    },
    "conversionOutline": {
        "advanced": [],
        "css": [],
        "module": {
            "content": "content.innerContent.*",
            "inline_fonts": "content.decoration.inlineFont.*.families",
            "pin_address": "pin.innerContent.*.address",
            "pin_address_lat": "pin.innerContent.*.lat",
            "pin_address_lng": "pin.innerContent.*.lng",
            "title": "title.innerContent.*",
            "zoom_level": "pin.innerContent.*.zoom"
        },
        "valueExpansionFunctionMap": {
            "inline_fonts": "convertInlineFont"
        }
    },
    "defaults": {
        "printedStyle": [],
        "render": {
            "pin": {
                "innerContent": {
                    "desktop": {
                        "value": {
                            "address": "",
                            "lat": 0,
                            "lng": 0,
                            "zoom": 18
                        }
                    }
                }
            }
        }
    },
